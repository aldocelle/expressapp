# Solo servidor. Nunca usar VITE_* para credenciales.
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3001
TRUST_PROXY_HOPS=0
# Modo real por defecto. true habilita un catálogo ficticio, claramente marcado.
RADAR_DEMO=false
# Ruta absoluta recomendada; por defecto: data/radar.sqlite en el repositorio.
# RADAR_DB_PATH=/var/lib/expressapps/radar.sqlite
MERCADO_PUBLICO_TICKET=
RADAR_SYNC_DAYS=3
RADAR_DETAIL_LIMIT=30
RADAR_SYNC_MINUTES=30
# Para configurar/restablecer una cuenta con npm run radar:user.
# Retira estas variables del entorno tras provisionar el usuario.
# RADAR_USER_EMAIL=tu@empresa.cl
# RADAR_USER_NAME=Tu nombre
# RADAR_ORG_NAME=ExpressWebsite
# RADAR_USER_PASSWORD=elige-una-clave-unica-de-al-menos-14-caracteres
# Destino nuevo y absoluto para npm run radar:backup.
# RADAR_BACKUP_PATH=/ruta/privada/radar-backup.sqlite
